# 家庭监控系统环境变量模板
# 复制本文件为 `.env` 后按环境修改；`.env` 含真实口令，禁止提交到版本库。
# 无 `VITE_` 前缀的变量由服务端在运行时读取；`VITE_*` 会写入前端构建产物，不能存放真正的服务端密钥。

# =============================================================================
# 1. 服务端基础配置、访问控制与 WebRTC
# =============================================================================
# NODE_ENV：运行环境，开发使用 development，生产使用 production。
# PORT：Express / Socket.IO 监听端口。
# PUBLIC_BASE_PATH：部署子路径；根路径留空，子路径示例 `/surveillance`。
# ROOM_TOKEN：采集端与观看端加入房间的共享口令；生产环境使用随机长字符串。
# MAX_VIEWERS_PER_ROOM：房间未单独配置时的默认观看端上限，范围 1–99。
# ALLOWED_ORIGINS：允许访问服务端的浏览器 Origin，逗号分隔，不包含路径。
# ICE_SERVERS_JSON：服务端下发的 STUN/TURN 配置，必须是合法 JSON 数组。
NODE_ENV=development
PORT=3333
PUBLIC_BASE_PATH=
ROOM_TOKEN=change-me
MAX_VIEWERS_PER_ROOM=2
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3333
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:global.stun.twilio.com:3478"}]

# =============================================================================
# 2. 企业微信中转与陌生人脸告警
# =============================================================================
# WEWORK_RELAY_*：企业微信中转服务地址、鉴权密钥和接收人；URL 留空则禁用推送。
# FACE_ALERT_ORIGIN_PRIMARY：告警正文中的首选观看入口 Origin，通常填写内网/Tailscale HTTPS 地址。
# FACE_ALERT_ORIGIN_SECONDARY：告警正文中的备用观看入口 Origin，通常填写公网 HTTPS 地址。
# FACE_ALERT_COOLDOWN_MS：同一房间连续告警的最短间隔（毫秒）。
WEWORK_RELAY_URL=
WEWORK_RELAY_API_KEY=
WEWORK_RELAY_TOUSER=
FACE_ALERT_ORIGIN_PRIMARY=https://localhost
FACE_ALERT_ORIGIN_SECONDARY=https://localhost
FACE_ALERT_COOLDOWN_MS=120000

# =============================================================================
# 3. 后台管理接口
# =============================================================================
# ADMIN_TOKEN：`/api/admin/*` 的管理口令；留空则禁用对应管理能力。
ADMIN_TOKEN=

# =============================================================================
# 4. Vite 前端构建与连接配置
# =============================================================================
# pnpm dev：由 scripts/run-dev.mjs 从根 `.env` 注入 server 和 Vite。
# pnpm build:prod：从根 `.env` 推导并注入前端构建所需的 `VITE_*`。
# VITE_PUBLIC_BASE_PATH：须与 PUBLIC_BASE_PATH 一致。
# VITE_ROOM_TOKEN：须与 ROOM_TOKEN 一致；它会进入浏览器构建产物，不属于真正的服务端密钥。
# VITE_ICE_SERVERS_JSON：前端 WebRTC 兜底配置，建议与 ICE_SERVERS_JSON 一致。
VITE_PUBLIC_BASE_PATH=
VITE_ROOM_TOKEN=change-me
VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:global.stun.twilio.com:3478"}]

# 页面与信令不同源时设置 VITE_SOCKET_URL；留空则使用页面当前 Origin。
# VITE_SOCKET_PATH 可覆盖默认的 `{VITE_PUBLIC_BASE_PATH}/socket.io/`，一般无需设置。
VITE_SOCKET_URL=
VITE_SOCKET_PATH=

# 可选：自托管 face-api.js 权重目录，例如 `/face-api-weights`；留空使用默认 jsDelivr CDN。
VITE_FACE_API_MODEL_BASE=

# 后台生成房间入口时使用的公网/内网 Origin，只填协议、主机和可选端口，不带部署子路径。
# 任一变量留空时，对应入口使用当前后台页面的 `location.protocol + '//' + location.host`。
VITE_PUBLIC_ORIGIN=
VITE_INTERNAL_ORIGIN=
