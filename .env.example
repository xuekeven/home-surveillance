# 复制为 `.env` 后按需填写。勿将 `.env` 提交到版本库。
#
# --- Node / Express（PM2、npm run dev、npm run start）---
# 生产部署建议在 `.env` 中设为 production（或由宿主环境导出）。
NODE_ENV=development
PORT=3333
PUBLIC_BASE_PATH=
ROOM_TOKEN=change-me
# 可选：房间策略 JSON 未写 maxViewersPerRoom 时的默认观看端上限（默认 2，范围 1–99）；后台可按房间覆盖
MAX_VIEWERS_PER_ROOM=2
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3333
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:global.stun.twilio.com:3478"}]

# 企微告警中转（留空则不调用 relay）
WEWORK_RELAY_URL=
WEWORK_RELAY_API_KEY=
WEWORK_RELAY_TOUSER=

# 陌生人脸告警推送正文里的「观看入口」链接：`origin + PUBLIC_BASE_PATH + /viewer/{房间}`。
# 填两套是给手机上两条可选入口（如内网域名 + 公网域名）；不设则用代码默认。
FACE_ALERT_ORIGIN_PRIMARY=https://localhost
FACE_ALERT_ORIGIN_SECONDARY=https://localhost
# 服务端同一房间 consecutive 告警最短间隔（毫秒），防抖减轻 relay / 企微刷屏。
FACE_ALERT_COOLDOWN_MS=120000

# 后台 /api/admin/*（留空则禁用对应管理能力）
ADMIN_TOKEN=

# --- Vite 构建期（须与上面对齐 ROOM_TOKEN / ICE）---
# `npm run dev`：由仓库根 `.env` 经 scripts/run-dev 注入进程环境；Vite 也从仓库根读 envDir。
# `npm run build:prod`：脚本会从根 `.env` 注入 web 构建所需的 `VITE_*`。
VITE_PUBLIC_BASE_PATH=
VITE_ROOM_TOKEN=change-me
VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:global.stun.twilio.com:3478"}]
# 后台房间列表的公网 / 内网入口 Origin（只填协议 + 主机 + 可选端口，不带 PUBLIC_BASE_PATH）
VITE_PUBLIC_ORIGIN=http://localhost:5173
VITE_INTERNAL_ORIGIN=http://localhost:5173
