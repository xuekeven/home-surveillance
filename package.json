{
  "name": "home-surveillance",
  "version": "1.0.0",
  "description": "家庭监控系统",
  "keywords": [
    "家庭监控",
    "监控系统",
    "家庭云",
    "监控"
  ],
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build": "npm run build -w web && npm run build -w server",
    "build:prod": "node scripts/build-prod.mjs",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "dotenv": "17.4.2",
    "typescript": "6.0.3"
  }
}
