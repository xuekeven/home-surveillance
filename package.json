{
  "name": "home-surveillance",
  "version": "1.0.0",
  "description": "家庭监控系统",
  "keywords": [
    "家庭监控",
    "监控系统",
    "家庭云",
    "监控"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build": "pnpm --filter @home-surveillance/web build && pnpm --filter @home-surveillance/server build",
    "build:prod": "node scripts/build-prod.mjs",
    "typecheck": "pnpm --filter @home-surveillance/server typecheck && pnpm --filter @home-surveillance/web typecheck",
    "start": "pnpm --filter @home-surveillance/server start"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "dotenv": "17.4.2",
    "typescript": "6.0.3"
  }
}
